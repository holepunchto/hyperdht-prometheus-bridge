{
  "name": "hyper-dht-prometheus",
  "version": "2.0.1",
  "description": "Bridge to scrape Prometheus metrics fully peer to peer",
  "main": "index.js",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "prettier --check . && lunte && brittle --coverage test/test.js",
    "test:bare": "brittle-bare --coverage test/test.js",
    "integration": "./prep-integration-test.sh && brittle test/integration.js",
    "integration:bare": "./prep-integration-test.sh && brittle-bare test/integration.js"
  },
  "bin": {
    "hyper-dht-prometheus": "./run.js",
    "hyper-dht-prometheus-bare": "./run-bare.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holepunchto/hyper-dht-prometheus.git"
  },
  "keywords": [
    "Prometheus",
    "dht",
    "hyperdht",
    "peer-to-peer",
    "p2p"
  ],
  "author": "Holepunch Inc",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/holepunchto/hyper-dht-prometheus/issues"
  },
  "homepage": "https://github.com/holepunchto/hyper-dht-prometheus#readme",
  "devDependencies": {
    "bare-events": "^2.9.1",
    "bare-fetch": "^3.0.1",
    "bare-path": "^3.0.1",
    "bare-process": "^4.5.0",
    "bare-subprocess": "^6.1.0",
    "brittle": "^3.5.2",
    "hypercore-crypto": "^3.4.2",
    "hyperdht": "^6.15.1",
    "lunte": "^1.8.0",
    "newline-decoder": "^1.0.2",
    "prettier": "^3.8.4",
    "prettier-config-holepunch": "^2.0.0",
    "test-tmp": "^1.2.1",
    "z32": "^1.1.0"
  },
  "dependencies": {
    "b4a": "^1.6.6",
    "bare-fs": "^4.7.2",
    "bare-node-runtime": "1.4.0",
    "bare-prom-client": "^15.1.9",
    "debounceify": "^1.1.0",
    "dht-prom-alias-rpc": "^2.0.0",
    "dht-prom-client": "^2.0.0",
    "fastify": "^5.8.5",
    "graceful-goodbye": "^1.3.0",
    "hypercore-id-encoding": "^1.3.0",
    "hyperswarm": "^4.7.15",
    "hyperswarm-stats": "^1.1.0",
    "pino": "^9.2.0",
    "protomux-rpc": "^1.5.2",
    "protomux-rpc-client": "^2.0.1",
    "ready-resource": "^1.1.1",
    "repl-swarm": "^2.1.0",
    "safety-catch": "^1.0.2"
  },
  "imports": {
    "#globals": {
      "bare": "./lib/globals/bare.js",
      "default": "./lib/globals/node.js"
    },
    "path": {
      "bare": "bare-path",
      "default": "path"
    },
    "events": {
      "bare": "bare-events",
      "default": "events"
    },
    "fs": {
      "bare": "bare-fs",
      "default": "fs"
    },
    "process": {
      "bare": "bare-process",
      "default": "process"
    },
    "child_process": {
      "bare": "bare-subprocess",
      "default": "child_process"
    }
  }
}
